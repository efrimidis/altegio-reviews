# --- Altegio (reviews + booking) ---
ALTEGIO_BEARER_TOKEN=        # partner token
ALTEGIO_USER_TOKEN=          # user token (reviews only)
ALTEGIO_COMPANY_ID=          # location id used for the reviews widget

# --- Telegram (daily free-slots post) ---
# Create a bot via @BotFather, add it as an admin to the channel.
TELEGRAM_BOT_TOKEN=          # e.g. 123456:AA...
TELEGRAM_CHANNEL_ID=         # @public_channel or numeric -100... id

# --- Telegram (daily payroll report -> private group) ---
# Add the bot to the private group. REPORT_BOT_TOKEN may be left blank to reuse
# TELEGRAM_BOT_TOKEN; only REPORT_CHAT_ID is then required.
REPORT_BOT_TOKEN=            # optional; defaults to TELEGRAM_BOT_TOKEN
REPORT_CHAT_ID=              # numeric group/supergroup id (e.g. -100...)
# Random value used by Telegram to sign callback webhook requests. Required
# when PUBLIC_URL / RENDER_EXTERNAL_URL is set. Use at least 24 characters;
# allowed characters are A-Z, a-z, 0-9, _ and -.
REPORT_WEBHOOK_SECRET=

# --- Optional ---
# Required to enable POST /publish-slots and POST /publish-report. Send it as
# `Authorization: Bearer <value>`. If blank, both manual routes stay disabled.
PUBLISH_SECRET=
PUBLIC_URL=                  # public HTTPS service URL; Render sets its own URL
REVIEWS_COUNT=20
CACHE_TTL_MINUTES=10
REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
ALTEGIO_MAX_RETRIES=2
ALTEGIO_MIN_INTERVAL_MS=210  # keeps requests below Altegio's 5 req/sec limit
